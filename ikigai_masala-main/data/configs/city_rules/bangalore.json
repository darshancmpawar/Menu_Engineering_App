      "type": "selector_frequency",
      "selector": {
        "flag": "is_black_dal"
      },
      "base_slot": "dal",
      "max": 1
    },
    {
      "name": "pappu_dal_weekly",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_pappu_dal"
      },
      "base_slot": "dal",
      "max": 1
    },
    {
      "name": "liquid_desserts_twice_nonconsecutive",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_liquid_dessert"
      },
      "base_slot": "dessert",
      "exact": 2,
      "non_consecutive": true
    },
    {
      "name": "potato_veg_gravy_weekly",
      "type": "selector_frequency",
      "selector": {
        "key_ingredient": "potato"
      },
      "base_slot": "veg_gravy",
      "max": 1
    },
    {
      "name": "potato_veg_dry_weekly",
      "type": "selector_frequency",
      "selector": {
        "key_ingredient": "potato"
      },
      "base_slot": "veg_dry",
      "max": 1
    },
    {
      "name": "lentil_daily_max_3",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_lentil_based"
      },
      "daily_max": 3
    },
    {
      "name": "leafy_daily_max_1",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_leafy_based_dish"
      },
      "daily_max": 1
    },
    {
      "name": "whole_legume_daily_max_1",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_whole_legume_based"
      },
      "exclude": {
        "flag": "is_legume_salad"
      },
      "daily_max": 1
    },
    {
      "name": "special_sambar_weekly",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_special_sambar"
      },
      "base_slot": "sambar",
      "max": 1
    },
    {
      "_comment": "The 15-day rolling window behind special_sambar_weekly (rulebook 82). The weekly max caps it within a plan; this reads saved history so a special sambar served last week is held off until the 15 days clear.",
      "name": "special_sambar_15d_window",
      "type": "selector_history_window",
      "selector": {
        "flag": "is_special_sambar"
      },
      "base_slot": "sambar",
      "window_days": 15
    },
    {
      "name": "maida_bread_weekly",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_maida_bread"
      },
      "base_slot": "bread",
      "max": 1
    },
    {
      "name": "multigrain_bread_weekly",
      "type": "selector_frequency",
