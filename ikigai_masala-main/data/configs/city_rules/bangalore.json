    {
      "name": "dal_colour_non_consecutive",
      "type": "attribute_grouping",
      "base_slot": "dal",
      "group_by": "item_color",
      "non_consecutive": true
    },
    {
      "name": "sambar_key_ingredient_weekly",
      "type": "attribute_grouping",
      "base_slot": "sambar",
      "group_by": "key_ingredient",
      "max_per_group": 1
    },
    {
      "name": "premiums_different_days",
      "type": "soft_preference",
      "mode": "different_day",
      "priority": "high",
      "selector_a": {
        "flag": "is_premium_gravy"
      },
      "base_slot_a": "veg_gravy",
      "selector_b": {
        "flag": "is_premium_veg_dry"
      },
      "base_slot_b": "veg_dry"
    },
    {
      "name": "veg_gravy_key_ingredient_variety",
      "type": "soft_preference",
      "mode": "avoid_attribute_repeat",
      "priority": "high",
      "base_slot": "veg_gravy",
      "group_by": "key_ingredient"
    },
    {
      "name": "avoid_consecutive_north_nonveg",
      "type": "soft_preference",
      "mode": "avoid_consecutive",
      "priority": "medium",
      "base_slot": "nonveg_main",
      "selector": {
        "cuisine_family": "north_indian"
      }
    },
    {
      "name": "avoid_consecutive_south_nonveg",
      "type": "soft_preference",
      "mode": "avoid_consecutive",
      "priority": "medium",
      "base_slot": "nonveg_main",
