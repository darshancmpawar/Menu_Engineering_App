        "cuisine_family": "south_indian"
      }
    },
    {
      "name": "avoid_consecutive_north_rice",
      "type": "soft_preference",
      "mode": "avoid_consecutive",
      "priority": "medium",
      "base_slot": "rice",
      "selector": {
