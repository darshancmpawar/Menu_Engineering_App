{
  "description": "Complete menu rules for Indian lunch menu planning — matches old app rule set",
  "rules": [
    {
      "name": "item_cooldown_20d",
      "type": "item_cooldown",
      "cooldown_days": 20
    },
    {
      "name": "ricebread_gap_10d",
      "type": "ricebread_gap",
      "gap_days": 10
    },
    {
      "name": "theme_cuisine_filter",
      "type": "theme_slot_filter",
      "exempt_slots": [
        "welcome_drink",
        "dal",
        "sambar",
        "rasam",
        "starter",
        "soup",
        "salad",
        "healthy_rice"
      ]
    },
    {
      "name": "unique_items_session",
      "type": "unique_items",
      "scope": "session"
    },
    {
      "name": "monday_mix",
      "type": "theme_day"
    },
    {
      "name": "deep_fried_coupling",
      "type": "coupling"
    },
    {
      "name": "curd_raita_logic",
      "type": "curd_side",
      "pulao_subcats": [
        "south_veg_pulao",
        "north_simple_veg_pulao",
        "north_rich_pulao",
        "millet_pulao",
        "mixed_grain_pulao"
      ]
    },
    {
      "name": "premium_veg_gravy_exactly_one",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_premium_gravy"
      },
      "base_slot": "veg_gravy",
      "exact": 1
    },
    {
      "name": "premium_veg_dry_exactly_one",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_premium_veg_dry"
      },
      "base_slot": "veg_dry",
      "exact": 1
    },
    {
      "name": "welcome_drink_no_repeat_color",
      "type": "welcome_drink_color"
    },
    {
      "name": "buttermilk_twice_weekly",
      "type": "welcome_drink_buttermilk",
      "count": 2,
      "non_consecutive": true
    },
    {
      "name": "no_repeat_weeks",
      "type": "week_signature_cooldown",
      "cooldown_days": 30
    },
    {
      "name": "prefer_theme_starters",
      "type": "theme_starter_preference",
      "bonus_weight": 1000000000000000
    },
    {
      "name": "penalize_non_theme_fallback",
      "type": "theme_fallback_penalty",
      "penalty": 1000000000000000
    },
    {
      "name": "nonveg_biryani_once_per_week",
      "type": "nonveg_biryani_weekly",
      "max_per_week": 1
    },
    {
      "_comment": "nonveg_biryani_once_per_week counts biryani DAYS, so a counter with 2+ nonveg slots could satisfy it by stacking two biryanis onto one day. This caps the dishes per day so the pair is biryani + something else. allowed_day_types keeps the biryani on the biryani day: a 'mix' day is not narrowed by the theme filter at all, so without this a themed counter could serve biryani on Monday and none on its actual biryani day. A counter themed biryani every weekday is unaffected (every day is an allowed day).",
      "name": "nonveg_biryani_one_per_day",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_nonveg_biryani"
      },
      "base_slot": "nonveg_main",
      "daily_max": 1,
      "allowed_day_types": [
        "biryani"
      ]
    },
    {
      "name": "mixed_veg_gravy_weekly",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_mixedveg_gravy"
      },
      "base_slot": "veg_gravy",
      "max": 1
    },
    {
      "name": "veg_kofta_weekly",
      "type": "selector_frequency",
      "selector": {
        "flag": "is_veg_kofta_gravy"
      },
      "base_slot": "veg_gravy",
      "max": 1
    },
    {
