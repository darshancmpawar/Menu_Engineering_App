{
  "Tekion": {
    "disable": [],
    "rules": [
      {
        "name": "tekion_no_mushroom",
        "type": "ingredient_ban",
        "ingredients": [
          "mushroom"
        ]
      },
      {
        "name": "tekion_liquid_rice_once",
        "type": "item_frequency",
        "base_slot": "rice",
        "selector": {
          "flag": "is_liquid_rice"
        },
        "min_per_week": 1,
        "max_per_week": 1
      },
      {
        "name": "tekion_nonveg_mwf",
        "type": "slot_day_restriction",
        "base_slot": "nonveg_main",
        "allowed_weekdays": [
          "mon",
          "wed",
          "fri"
        ]
      },
      {
        "_comment": "Non-veg gravy Monday and Wednesday, chicken biryani Friday - Friday is this counter's biryani day (client confirmed, and both sample weeks serve a veg biryani there too). Tuesday and Thursday are blank via tekion_nonveg_mwf. Mon/Wed exclude is_egg_dish because two egg dishes are mis-flagged is_south_chicken_gravy in the ontology.",
        "name": "tekion_nonveg_by_weekday",
        "type": "slot_composition",
        "base_slot": "nonveg_main",
        "min_slot_count": 1,
        "components_by_weekday": {
          "mon": [
            {
              "selector": {
                "any_flag": [
                  "is_north_chicken_gravy",
                  "is_south_chicken_gravy"
                ]
              },
              "exclude": {
                "flag": "is_egg_dish"
              },
              "count": 1
            }
          ],
          "wed": [
            {
              "selector": {
                "any_flag": [
                  "is_north_chicken_gravy",
                  "is_south_chicken_gravy"
                ]
              },
              "exclude": {
                "flag": "is_egg_dish"
              },
              "count": 1
            }
          ],
          "fri": [
            {
              "selector": {
                "flag": "is_nonveg_biryani"
              },
              "count": 1
            }
          ]
        }
      },
      {
        "_comment": "'Chinese Rice & Chinese gravy to be served on Tuesday.' Both sample weeks honour it (Chilli Garlic Fried Rice, Herbed Fried Rice).",
        "name": "tekion_chinese_rice_tuesday",
        "type": "slot_composition",
        "base_slot": "rice",
        "min_slot_count": 1,
        "components_by_weekday": {
          "tue": [
            {
              "selector": {
                "any_flag": [
                  "is_chinese_fried_rice",
                  "is_chinese_carb"
                ]
              },
              "count": 1
            }
          ]
        }
      },
      {
        "_comment": "The veg-gravy half of the same Tuesday rule.",
        "name": "tekion_chinese_gravy_tuesday",
        "type": "slot_composition",
        "base_slot": "veg_gravy",
        "min_slot_count": 1,
        "components_by_weekday": {
          "tue": [
            {
              "selector": {
                "flag": "is_chinese_veg_gravy"
              },
              "count": 1
            }
          ]
        }
      },
      {
        "_comment": "'Paneer Gravy every wednesday.' Written '(Lunch & Dinner)'; dinner is out of scope, so this is the whole rule. Both sample weeks serve paneer then.",
        "name": "tekion_paneer_gravy_wednesday",
        "type": "slot_composition",
        "base_slot": "veg_gravy",
        "min_slot_count": 1,
        "components_by_weekday": {
          "wed": [
            {
              "selector": {
                "flag": "is_paneer_gravy"
              },
              "count": 1
            }
          ]
        }
      },
      {
        "_comment": "'Khichdi every Thursday.' There is no is_khichdi flag; every khichdi in the ontology carries is_liquid_rice, and tekion_liquid_rice_once already caps liquid rice at one a week, so pinning Thursday lands that one there. Both sample weeks serve a khichdi on Thursday.",
        "name": "tekion_khichdi_thursday",
        "type": "slot_composition",
        "base_slot": "rice",
        "min_slot_count": 1,
        "components_by_weekday": {
          "thu": [
            {
              "selector": {
                "flag": "is_liquid_rice"
              },
              "count": 1
            }
          ]
        }
      }
    ],
    "constant_items": {}
  },
