{
  "Zscaler": {
    "disable": [
      "mixedveg_pulao_biryani_weekly",
      "potato_veg_gravy_weekly",
      "potato_veg_dry_weekly"
    ],
    "use": [
      {
        "ref": "selector_once_a_week",
        "as": "zscaler_mushroom_exact_1"
      }
    ],
    "rules": [
      {
        "name": "zscaler_biryani_pulao_rice_2x",
        "type": "selector_frequency",
        "base_slot": "rice",
        "selector": {
          "any_flag": [
            "is_nonveg_biryani",
            "is_mixedveg_biryani",
            "is_premium_biryani",
            "is_pulao"
          ]
        },
        "min": 2
      },
      {
        "name": "zscaler_chinese_veg_dry_starter",
        "type": "selector_frequency",
        "base_slot": "starter",
        "selector": {
          "cuisine_family": "chinese"
        },
        "max": 2
      },
      {
        "name": "zscaler_no_potato",
        "type": "ingredient_ban",
        "ingredients": [
          "potato"
        ]
      },
      {
        "name": "zscaler_babycorn_exact_1",
        "type": "selector_frequency",
        "selector": {
          "key_ingredient": "baby_corn"
        },
        "min": 1,
        "max": 1
      },
      {
        "name": "zscaler_paneer_gravy_1",
        "type": "selector_frequency",
        "selector": {
          "flag": "is_paneer_gravy"
        },
        "min": 1,
        "max": 1
      },
      {
        "name": "zscaler_paneer_fry_1",
        "type": "selector_frequency",
        "selector": {
          "flag": "is_paneer_fry"
        },
        "min": 1,
        "max": 1
      }
    ],
    "constant_items": {}
  }
}
