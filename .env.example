# Copy to .env (NOT committed) and fill in real values.
#
#   cp .env.example .env
#
# Required — the API fails at startup if any of these is missing or empty:
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<service_role / sb_secret_... key — NOT publishable>

# Optional:
# APP_TIMEZONE=Asia/Kolkata
# APP_VERSION=$(git rev-parse --short HEAD)
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS=https://prod.example.com
